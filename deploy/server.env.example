# 腾讯云轻量服务器 SSH
SSH_HOST=请填写服务器公网IP
SSH_PORT=22
SSH_USER=root

# 登录方式：password 或 private_key
SSH_AUTH_METHOD=password

# 使用密码登录时填写；不要提交此文件
SSH_PASSWORD=请填写服务器登录密码

# 推荐填写本机 SSH 私钥的绝对路径，例如：
# /Users/sxunt/.ssh/tencent_lighthouse
# 使用密码登录时保持为空
SSH_PRIVATE_KEY=请填写SSH私钥绝对路径

# 服务器上的项目部署目录
REMOTE_PROJECT_DIR=/data/wardrobe

# 后端域名，没有域名时可暂时留空，使用服务器公网 IP
API_DOMAIN=

# HTTPS 证书申请邮箱；没有域名时可暂时留空
SSL_EMAIL=

# 腾讯云轻量服务器系统，例如 ubuntu-22.04
SERVER_OS=ubuntu
